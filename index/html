<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Приглашение на свадьбу | Никита & Диана</title>
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,500;0,600;0,700;1,400;1,500&family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;0,600;1,300;1,400&family=Montserrat:wght@300;400;500;600&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="imba.css">
</head>
<body>
    <!-- Плавающие сердечки и цветочки -->
    <div class="hearts-flowers-container" aria-hidden="true">
        <span class="floating-element heart">❤️</span>
        <span class="floating-element flower">🌸</span>
        <span class="floating-element heart">❤️</span>
        <span class="floating-element flower">🌷</span>
        <span class="floating-element heart">❤️</span>
        <span class="floating-element flower">💮</span>
        <span class="floating-element heart">❤️</span>
        <span class="floating-element flower">🌸</span>
        <span class="floating-element heart">❤️</span>
        <span class="floating-element flower">🌷</span>
        <span class="floating-element heart">❤️</span>
        <span class="floating-element flower">💮</span>
    </div>

    <div class="main-wrapper">
        <section class="hero-section">
            <div class="photo-frame" id="photoFrame" title="Нажмите, чтобы вставить ваше фото">
                <div class="photo-placeholder" id="photoPlaceholder">
                    <span class="icon-camera">📷</span>
                    <span class="text-hint">вставьте фото</span>
                </div>
                <img id="photoImg" src="" alt="Фото пары" style="display:none;"
                onerror="this.style.display='none'; document.getElementById('photoPlaceholder').style.display='flex';">
            </div>
            <h1 class="hero-names">
                Никита <span class="hero-ampersand">&</span> Диана
            </h1>
            <p class="hero-date">11 августа 2026 года · 11:00</p>
        </section>

        <div class="divider">— ✦ —</div>

        <section class="chat-section" id="chatSection">
            <div class="chat-header">
                <div class="chat-avatar">💌</div>
                <div class="chat-header-info">
                    <div class="chat-header-name">Свадебное приглашение</div>
                    <div class="chat-header-status"><span class="chat-header-dot"></span>Ждём ваш ответ</div>
                </div>
            </div>
            <div class="chat-messages" id="chatMessages"></div>
            <div class="chat-input-area">
                <div class="chat-input-row">
                    <input type="text" id="guestName" placeholder="Ваше имя (например: Сёма, Даня)" maxlength="60">
                    <select id="guestResponse">
                        <option value="confirmed">✅ Буду с радостью!</option>
                        <option value="maybe">🤔 Пока не уверен(а)</option>
                        <option value="declined">💔 К сожалению, не смогу</option>
                    </select>
                </div>
                <div class="chat-input-row plus-one-row">
                    <label class="radio-label">
                        <input type="radio" name="plusOne" value="1" checked> Только я
                    </label>
                    <label class="radio-label">
                        <input type="radio" name="plusOne" value="2"> Со мной будет +1
                    </label>
                    <input type="text" id="companionName" class="companion-input hidden" placeholder="Имя спутника (например: Даня)" maxlength="60">
                </div>
                <button class="btn-send" id="btnSend">
                    <span class="send-icon">✉️</span> Отправить
                </button>
            </div>
        </section>

        <section class="guests-section" id="guestsSection">
            <h2 class="guests-title">💍 Зарегистрированные гости</h2>
            <p class="guests-subtitle">Список гостей, подтвердивших участие</p>
            <span class="guests-counter" id="guestsCounter">Всего: 0</span>
            <div class="guests-list" id="guestsList">
                <span class="no-guests">Пока никто не зарегистрировался. Будьте первым! ✨</span>
            </div>
        </section>

        <div class="info-blocks-container" id="infoBlocksContainer"></div>

        <div class="add-block-area">
            <button class="btn-add-block" id="btnAddBlock">
                <span class="plus-icon">＋</span> Добавить пожелание молодожёнам
            </button>
        </div>

        <div class="footer-note">
            <span class="footer-heart">❤</span> С любовью ждём вас на нашем празднике <span class="footer-heart">❤</span>
        </div>
    </div>

    <!-- Модалка добавления блока -->
    <div class="modal-overlay hidden" id="modalOverlay">
        <div class="modal-dialog">
            <h3>✨ Новый информационный блок</h3>
            <label for="blockIcon">Иконка (эмодзи)</label>
            <input type="text" id="blockIcon" value="📍" maxlength="4" placeholder="Например: 📍">
            <label for="blockTitle">Заголовок блока</label>
            <input type="text" id="blockTitle" placeholder="Например: Место проведения" maxlength="80">
            <label for="blockContent">Содержание</label>
            <textarea id="blockContent" placeholder="Опишите детали: адрес, время, особенности..." rows="3"></textarea>
            <div class="modal-buttons">
                <button class="btn-cancel" id="btnCancel">Отмена</button>
                <button class="btn-confirm" id="btnConfirm">Добавить блок</button>
            </div>
        </div>
    </div>

    <!-- Мем-модалка для согласия (Шиф) -->
    <div class="meme-modal hidden" id="memeYes">
        <div class="meme-content">
            <span class="meme-close" id="memeYesClose">&times;</span>
            <img src="https://via.placeholder.com/400x400/FFB6C1/FFFFFF?text=Шиф+мем" alt="Шиф мем" class="meme-image">
            <p class="meme-caption">Ура! Ты будешь с нами! 💕</p>
        </div>
    </div>

    <!-- Мем-модалка для отказа (котики) -->
    <div class="meme-modal hidden" id="memeNo">
        <div class="meme-content">
            <span class="meme-close" id="memeNoClose">&times;</span>
            <img src="https://via.placeholder.com/400x400/FFB6C1/FFFFFF?text=Котики+грустят" alt="Грустные котики" class="meme-image">
            <p class="meme-caption">Очень жаль... но мы всё равно тебя любим! 🐱</p>
        </div>
    </div>

    <div class="toast" id="toast"></div>

    <script src="script.js"></script>
    <!-- Кнопка экспорта -->
<div class="export-area">
    <button class="btn-export" id="btnExport">
        <span>📥</span> Экспорт страницы (скачать HTML)
    </button>
</div>
</body>
</html>
